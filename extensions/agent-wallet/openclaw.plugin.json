{
  "id": "agent-wallet",
  "kind": "wallet",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": { "type": "boolean" },
      "storePath": { "type": "string" },
      "encryptionKey": { "type": "string" },
      "chain": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "network": {
            "type": "string",
            "enum": [
              "ethereum",
              "base",
              "optimism",
              "arbitrum",
              "sepolia",
              "ton-mainnet",
              "ton-testnet"
            ]
          }
        }
      },
      "policy": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean" },
          "policyPath": { "type": "string" },
          "decisionLogPath": { "type": "string" },
          "statePath": { "type": "string" },
          "inlinePolicy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "version": { "type": "string", "enum": ["v1"] },
              "budget": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "dailyCap": { "type": "string" },
                  "perTxCap": { "type": "string" },
                  "currency": { "type": "string" }
                }
              },
              "scope": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "allowedContracts": { "type": "array", "items": { "type": "string" } },
                  "allowedMethods": { "type": "array", "items": { "type": "string" } },
                  "allowedTools": { "type": "array", "items": { "type": "string" } },
                  "allowedChains": {
                    "type": "array",
                    "items": { "type": "string", "enum": ["evm", "ton"] }
                  }
                }
              },
              "autoPay": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": { "type": "boolean" },
                  "maxRetries": { "type": "number" },
                  "maxAutoPayPerRequest": { "type": "string" }
                }
              },
              "ttl": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "notBefore": { "type": "string" },
                  "notAfter": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}
