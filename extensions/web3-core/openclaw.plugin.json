{
  "id": "web3-core",
  "uiHints": {
    "chain.network": {
      "label": "Blockchain Network",
      "help": "EVM chain to anchor audit records. Default: Base (L2).",
      "placeholder": "base"
    },
    "chain.rpcUrl": {
      "label": "RPC URL",
      "sensitive": true,
      "placeholder": "https://mainnet.base.org",
      "help": "JSON-RPC endpoint for the selected chain"
    },
    "chain.privateKey": {
      "label": "Signer Private Key",
      "sensitive": true,
      "help": "Private key used to sign anchor transactions (hex, with 0x prefix)"
    },
    "storage.provider": {
      "label": "Decentralized Storage Provider",
      "help": "Where to archive encrypted session data",
      "placeholder": "ipfs"
    },
    "storage.gateway": {
      "label": "IPFS/Arweave Gateway URL",
      "placeholder": "https://w3s.link",
      "help": "HTTP gateway for retrieving archived content"
    },
    "storage.pinataJwt": {
      "label": "Pinata JWT (for IPFS pinning)",
      "sensitive": true,
      "help": "JWT token for Pinata IPFS pinning service"
    },
    "storage.arweaveKeyfile": {
      "label": "Arweave Keyfile",
      "help": "Path to Arweave keyfile JSON used for signing uploads"
    },
    "storage.filecoinToken": {
      "label": "Filecoin Upload Token",
      "sensitive": true,
      "help": "API token for Filecoin-compatible upload service (e.g., web3.storage)"
    },
    "storage.filecoinEndpoint": {
      "label": "Filecoin Upload Endpoint",
      "placeholder": "https://api.web3.storage/upload",
      "help": "HTTP endpoint used for Filecoin uploads"
    },
    "privacy.onChainData": {
      "label": "On-chain Data Policy",
      "help": "What to write on-chain: hash_only (default) | hash_and_meta | encrypted_content"
    },
    "privacy.archiveEncryption": {
      "label": "Archive Encryption",
      "help": "Encrypt content before uploading to decentralized storage (default: true)"
    },
    "identity.allowSiwe": {
      "label": "Enable SIWE (Sign-In with Ethereum)",
      "help": "Allow wallet-based authentication via EIP-4361"
    },
    "identity.domain": {
      "label": "SIWE Domain",
      "help": "Domain used for SIWE verification (default: openclaw.ai)",
      "placeholder": "openclaw.ai"
    },
    "identity.uri": {
      "label": "SIWE URI",
      "help": "URI used in SIWE messages (default: https://openclaw.ai)",
      "placeholder": "https://openclaw.ai"
    },
    "identity.statement": {
      "label": "SIWE Statement",
      "help": "User-facing statement shown in SIWE messages"
    },
    "identity.challengeTtlMs": {
      "label": "SIWE Challenge TTL (ms)",
      "help": "How long a SIWE challenge stays valid before expiring"
    },
    "billing.enabled": {
      "label": "Enable Billing",
      "help": "Track usage and enforce quota limits"
    },
    "billing.quotaPerSession": {
      "label": "Quota per Session (credits)",
      "placeholder": "1000",
      "help": "Maximum credits per session before requiring top-up"
    },
    "x402.autopay.enabled": {
      "label": "Enable x402 Autopay",
      "help": "Allow x402 autopay flow when the wallet policy permits it"
    },
    "brain.enabled": {
      "label": "Enable Decentralized Brain",
      "help": "Enable the custom decentralized brain routing hook"
    },
    "brain.providerId": {
      "label": "Brain Provider ID",
      "help": "Provider ID used by the decentralized brain override"
    },
    "brain.defaultModel": {
      "label": "Brain Default Model",
      "help": "Model ID used when routing to the decentralized brain"
    },
    "brain.endpoint": {
      "label": "Brain Endpoint",
      "help": "Optional endpoint for openai-compat or websocket brain transport",
      "sensitive": true
    },
    "resources.enabled": {
      "label": "Enable Resource Sharing",
      "help": "Turn on the Web3 resource-sharing market features"
    },
    "resources.advertiseToMarket": {
      "label": "Advertise Resources To Market",
      "help": "Allow local provider offers to be published into the market"
    },
    "resources.provider.listen.enabled": {
      "label": "Enable Provider Routes",
      "help": "Expose the local resource provider HTTP routes"
    },
    "resources.provider.listen.bind": {
      "label": "Provider Bind Scope",
      "help": "Bind provider routes to loopback or LAN"
    },
    "resources.provider.listen.port": {
      "label": "Provider Listen Port",
      "help": "TCP port for the resource provider listener"
    },
    "resources.provider.listen.publicBaseUrl": {
      "label": "Provider Public Base URL",
      "help": "Optional externally routable base URL for provider access",
      "sensitive": true
    },
    "resources.provider.auth.mode": {
      "label": "Provider Auth Mode",
      "help": "Lease authentication mode for provider routes"
    },
    "resources.provider.auth.tokenTtlMs": {
      "label": "Provider Token TTL (ms)",
      "help": "How long issued lease tokens stay valid"
    },
    "resources.consumer.enabled": {
      "label": "Enable Resource Consumer",
      "help": "Allow this node to lease and call remote market resources"
    },
    "resources.consumer.preferLocalFirst": {
      "label": "Prefer Local First",
      "help": "Prefer local resources before remote market leases"
    },
    "browserIngest.enabled": {
      "label": "Enable Browser Ingest",
      "help": "Allow browser extension events to be posted into the Gateway"
    },
    "browserIngest.ingestPath": {
      "label": "Browser Ingest Path",
      "placeholder": "/plugins/web3-core/ingest",
      "help": "HTTP path for extension -> Gateway ingest"
    },
    "browserIngest.token": {
      "label": "Browser Ingest Token",
      "sensitive": true,
      "help": "Shared secret required by the browser extension"
    },
    "browserIngest.allowLoopback": {
      "label": "Allow Loopback Without Token",
      "help": "Permit localhost requests when no token is configured"
    },
    "browserIngest.maxBodyBytes": {
      "label": "Max Ingest Payload (bytes)",
      "placeholder": "65536",
      "help": "Maximum payload size accepted from the browser extension"
    },
    "monitor.enabled": {
      "label": "Enable Monitoring",
      "help": "Enable Web3 health snapshots and alert surfaces"
    },
    "monitor.notifications.enabled": {
      "label": "Enable Monitor Notifications",
      "help": "Allow Web3 monitor notifications to external channels"
    },
    "discovery.enabled": {
      "label": "Enable MDL Discovery",
      "help": "Enable decentralized discovery publish/discover pipeline"
    },
    "discovery.backend": {
      "label": "Discovery Backend",
      "help": "Discovery backend type: static (no-op) or libp2p"
    },
    "discovery.bootstrapPeers": {
      "label": "Discovery Bootstrap Peers",
      "help": "libp2p bootstrap multiaddrs used for discovery network join"
    },
    "discovery.rendezvousIntervalMs": {
      "label": "Discovery Interval (ms)",
      "placeholder": "30000",
      "help": "Periodic discover/republish interval"
    },
    "discovery.dhtKeyPrefix": {
      "label": "Discovery DHT Key Prefix",
      "placeholder": "/openclaw/resource",
      "help": "DHT key prefix used for resource-granular publish"
    },
    "rewards.enabled": {
      "label": "Enable Reward Surface",
      "help": "Expose reward lifecycle orchestration in the public Web3 surface"
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "chain": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "network": {
            "type": "string",
            "enum": ["base", "optimism", "arbitrum", "ethereum", "sepolia"],
            "default": "base"
          },
          "rpcUrl": { "type": "string" },
          "privateKey": { "type": "string" },
          "contractAddress": { "type": "string" }
        }
      },
      "storage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "provider": {
            "type": "string",
            "enum": ["ipfs", "arweave", "filecoin"],
            "default": "ipfs"
          },
          "gateway": { "type": "string" },
          "pinataJwt": { "type": "string" },
          "arweaveKeyfile": { "type": "string" },
          "filecoinToken": { "type": "string" },
          "filecoinEndpoint": {
            "type": "string",
            "default": "https://api.web3.storage/upload"
          }
        }
      },
      "privacy": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "onChainData": {
            "type": "string",
            "enum": ["hash_only", "hash_and_meta", "encrypted_content"],
            "default": "hash_only"
          },
          "archiveEncryption": {
            "type": "boolean",
            "default": true
          },
          "redactFields": {
            "type": "array",
            "items": { "type": "string" },
            "default": ["apiKey", "token", "password", "secret", "privateKey"]
          }
        }
      },
      "identity": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "allowSiwe": { "type": "boolean", "default": true },
          "requiredChainId": { "type": "number" },
          "domain": { "type": "string", "default": "openclaw.ai" },
          "uri": { "type": "string", "default": "https://openclaw.ai" },
          "statement": { "type": "string", "default": "Sign in to OpenClaw Web3" },
          "challengeTtlMs": { "type": "number", "default": 300000 }
        }
      },
      "billing": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": false },
          "quotaPerSession": { "type": "number", "default": 1000 },
          "costPerLlmCall": { "type": "number", "default": 1 },
          "costPerToolCall": { "type": "number", "default": 0.5 },
          "paymentTokenAddress": { "type": "string" },
          "paymentReceiverAddress": { "type": "string" }
        }
      },
      "x402": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "autopay": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": { "type": "boolean", "default": true }
            }
          }
        }
      },
      "brain": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": false },
          "providerId": { "type": "string", "default": "web3-decentralized" },
          "defaultModel": { "type": "string", "default": "" },
          "allowlist": {
            "type": "array",
            "items": { "type": "string" },
            "default": []
          },
          "endpoint": { "type": "string" },
          "protocol": {
            "type": "string",
            "enum": ["openai-compat", "custom-ws", "p2p"],
            "default": "openai-compat"
          },
          "fallback": {
            "type": "string",
            "enum": ["centralized"],
            "default": "centralized"
          },
          "timeoutMs": { "type": "number", "default": 30000 }
        }
      },
      "resources": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": false },
          "advertiseToMarket": { "type": "boolean", "default": false },
          "provider": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "listen": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": { "type": "boolean", "default": false },
                  "bind": {
                    "type": "string",
                    "enum": ["loopback", "lan"],
                    "default": "loopback"
                  },
                  "port": { "type": "number", "default": 0 },
                  "publicBaseUrl": { "type": "string" }
                }
              },
              "auth": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "mode": {
                    "type": "string",
                    "enum": ["siwe", "token"],
                    "default": "siwe"
                  },
                  "tokenTtlMs": { "type": "number", "default": 600000 },
                  "allowedConsumers": {
                    "type": "array",
                    "items": { "type": "string" },
                    "default": []
                  }
                }
              },
              "offers": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "models": {
                    "type": "array",
                    "default": [],
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["id", "label", "backend", "backendConfig", "price", "policy"],
                      "properties": {
                        "id": { "type": "string" },
                        "label": { "type": "string" },
                        "backend": {
                          "type": "string",
                          "enum": ["ollama", "lmstudio", "openai-compat", "custom"]
                        },
                        "backendConfig": {
                          "type": "object",
                          "additionalProperties": true
                        },
                        "price": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["unit", "amount", "currency"],
                          "properties": {
                            "unit": {
                              "type": "string",
                              "enum": ["token", "call", "query", "gb_day", "put", "get"]
                            },
                            "amount": { "type": "number" },
                            "currency": { "type": "string" }
                          }
                        },
                        "policy": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["maxConcurrent", "allowTools"],
                          "properties": {
                            "maxConcurrent": { "type": "number" },
                            "maxTokens": { "type": "number" },
                            "allowTools": { "type": "boolean" }
                          }
                        }
                      }
                    }
                  },
                  "search": {
                    "type": "array",
                    "default": [],
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["id", "label", "backend", "backendConfig", "price"],
                      "properties": {
                        "id": { "type": "string" },
                        "label": { "type": "string" },
                        "backend": {
                          "type": "string",
                          "enum": ["searxng", "custom"]
                        },
                        "backendConfig": {
                          "type": "object",
                          "additionalProperties": true
                        },
                        "price": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["unit", "amount", "currency"],
                          "properties": {
                            "unit": {
                              "type": "string",
                              "enum": ["token", "call", "query", "gb_day", "put", "get"]
                            },
                            "amount": { "type": "number" },
                            "currency": { "type": "string" }
                          }
                        },
                        "policy": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "maxConcurrent": { "type": "number" },
                            "maxQueryChars": { "type": "number" }
                          }
                        }
                      }
                    }
                  },
                  "storage": {
                    "type": "array",
                    "default": [],
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["id", "label", "backend", "backendConfig", "price", "policy"],
                      "properties": {
                        "id": { "type": "string" },
                        "label": { "type": "string" },
                        "backend": {
                          "type": "string",
                          "enum": ["filesystem", "s3", "ipfs", "custom"]
                        },
                        "backendConfig": {
                          "type": "object",
                          "additionalProperties": true
                        },
                        "price": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["unit", "amount", "currency"],
                          "properties": {
                            "unit": {
                              "type": "string",
                              "enum": ["token", "call", "query", "gb_day", "put", "get"]
                            },
                            "amount": { "type": "number" },
                            "currency": { "type": "string" }
                          }
                        },
                        "policy": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["maxBytes"],
                          "properties": {
                            "maxBytes": { "type": "number" },
                            "allowMime": {
                              "type": "array",
                              "items": { "type": "string" }
                            },
                            "maxConcurrent": { "type": "number" }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "consumer": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": { "type": "boolean", "default": true },
              "preferLocalFirst": { "type": "boolean", "default": true }
            }
          }
        }
      },
      "browserIngest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": false },
          "ingestPath": { "type": "string", "default": "/plugins/web3-core/ingest" },
          "token": { "type": "string" },
          "allowLoopback": { "type": "boolean", "default": true },
          "maxBodyBytes": { "type": "number", "default": 65536 }
        }
      },
      "monitor": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": true },
          "notifications": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": { "type": "boolean", "default": false },
              "channels": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "webhook": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "url": { "type": "string" },
                      "method": {
                        "type": "string",
                        "enum": ["POST", "PUT"]
                      },
                      "headers": {
                        "type": "object",
                        "additionalProperties": { "type": "string" }
                      },
                      "timeout": { "type": "number" }
                    }
                  },
                  "wecom": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "webhookUrl": { "type": "string" },
                      "mentionUsers": {
                        "type": "array",
                        "items": { "type": "string" }
                      },
                      "mentionAll": { "type": "boolean" }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "discovery": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": false },
          "backend": {
            "type": "string",
            "enum": ["libp2p", "static"],
            "default": "static"
          },
          "bootstrapPeers": {
            "type": "array",
            "items": { "type": "string" },
            "default": []
          },
          "rendezvousIntervalMs": { "type": "number", "default": 30000 },
          "dhtKeyPrefix": { "type": "string", "default": "/openclaw/resource" }
        }
      },
      "rewards": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": true }
        }
      }
    }
  }
}
